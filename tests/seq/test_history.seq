include "../../src/sexpr"
include "../../src/vim-line"

: test-history ( -- )
  "Testing history functions..." io.write-line

  # Create empty history
  history-empty
  dup snil? [ "Empty history: OK" io.write-line ] [ "Empty history: FAIL" io.write-line ] if

  # Add first entry
  "(+ 1 2)" history-add
  dup history-length
  1 i.= [ "Length after add: OK (1)" io.write-line ] [ "Length after add: FAIL" io.write-line ] if

  # Get first entry
  dup 1 history-get
  "(+ 1 2)" string.equal? [ "Get 1: OK" io.write-line ] [ "Get 1: FAIL" io.write-line ] if

  # Add second entry
  "(+ 3 4)" history-add
  dup history-length
  2 i.= [ "Length after 2nd add: OK (2)" io.write-line ] [ "Length after 2nd: FAIL" io.write-line ] if

  # Get entries
  dup 1 history-get
  "(+ 3 4)" string.equal? [ "Get 1 (newest): OK" io.write-line ] [ "Get 1 newest: FAIL" io.write-line ] if

  dup 2 history-get
  "(+ 1 2)" string.equal? [ "Get 2 (older): OK" io.write-line ] [ "Get 2 older: FAIL" io.write-line ] if

  drop
  "Done!" io.write-line
;

: main ( -- ) test-history ;
